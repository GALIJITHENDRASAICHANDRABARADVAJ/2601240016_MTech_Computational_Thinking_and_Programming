{
  "version": "1.0",
  "description": "Rule set, weights, thresholds and lexicons for the Email Spam & Phishing Classifier. Edit freely; the file is validated on load.",
  "thresholds": {
    "phishing": 50,
    "spam": 40
  },
  "greedy": {
    "decisive_score": 90
  },
  "limits": {
    "max_body_chars": 500000
  },
  "indicators": {
    "url_shorteners": ["bit.ly", "tinyurl.com", "t.co", "goo.gl", "ow.ly", "is.gd", "buff.ly", "rebrand.ly", "cutt.ly", "shorturl.at", "tiny.cc", "rb.gy"],
    "suspicious_tlds": ["zip", "mov", "top", "xyz", "click", "link", "tk", "ml", "ga", "cf", "gq", "work", "loan", "icu", "cyou", "buzz", "rest", "country", "kim", "men", "party", "review", "stream", "download"],
    "free_mail_domains": ["gmail.com", "yahoo.com", "outlook.com", "hotmail.com", "aol.com", "mail.com", "gmx.com", "proton.me", "protonmail.com", "icloud.com", "yandex.com", "zoho.com", "live.com", "msn.com"],
    "dangerous_extensions": ["exe", "scr", "bat", "cmd", "com", "pif", "js", "jse", "vbs", "vbe", "wsf", "wsh", "ps1", "jar", "msi", "lnk", "iso", "img", "hta", "reg", "dll", "cpl"],
    "macro_extensions": ["docm", "xlsm", "pptm", "dotm", "xlam"],
    "html_extensions": ["html", "htm", "shtml", "xhtml"],
    "archive_extensions": ["zip", "rar", "7z", "gz", "tar", "cab", "ace"],
    "executive_titles": ["ceo", "cfo", "coo", "chief executive", "chief financial", "president", "managing director", "director", "payroll", "hr manager"]
  },
  "brands": [
    {"name": "PayPal", "keywords": ["paypal"], "domains": ["paypal.com", "paypal.me"]},
    {"name": "Microsoft", "keywords": ["microsoft", "office365", "office 365", "microsoft 365"], "domains": ["microsoft.com", "outlook.com", "office.com", "live.com", "microsoftonline.com", "office365.com", "azure.com"]},
    {"name": "Apple", "keywords": ["apple"], "domains": ["apple.com", "icloud.com"]},
    {"name": "Amazon", "keywords": ["amazon"], "domains": ["amazon.com", "amazon.co.uk", "amazon.in", "amazon.de", "amazon.ca", "amazonaws.com"]},
    {"name": "Google", "keywords": ["google"], "domains": ["google.com", "gmail.com", "youtube.com", "goo.gl"]},
    {"name": "Netflix", "keywords": ["netflix"], "domains": ["netflix.com"]},
    {"name": "Facebook", "keywords": ["facebook"], "domains": ["facebook.com", "facebookmail.com", "fb.com", "meta.com"]},
    {"name": "LinkedIn", "keywords": ["linkedin"], "domains": ["linkedin.com"]},
    {"name": "DHL", "keywords": ["dhl"], "domains": ["dhl.com", "dhl.de"]},
    {"name": "FedEx", "keywords": ["fedex"], "domains": ["fedex.com"]},
    {"name": "DocuSign", "keywords": ["docusign"], "domains": ["docusign.com", "docusign.net"]},
    {"name": "Dropbox", "keywords": ["dropbox"], "domains": ["dropbox.com", "dropboxmail.com"]},
    {"name": "Chase", "keywords": ["chase"], "domains": ["chase.com", "jpmorganchase.com", "jpmorgan.com"]},
    {"name": "Wells Fargo", "keywords": ["wells fargo", "wellsfargo"], "domains": ["wellsfargo.com"]},
    {"name": "Bank of America", "keywords": ["bank of america", "bankofamerica"], "domains": ["bankofamerica.com", "bofa.com"]},
    {"name": "HSBC", "keywords": ["hsbc"], "domains": ["hsbc.com", "hsbc.co.uk"]},
    {"name": "HDFC Bank", "keywords": ["hdfc"], "domains": ["hdfcbank.com", "hdfc.com"]},
    {"name": "ICICI Bank", "keywords": ["icici"], "domains": ["icicibank.com"]}
  ],
  "lexicons": {
    "spam_keywords": [
      "winner", "congratulations", "you have won", "you've won", "click here", "buy now", "limited time",
      "act now", "100% free", "absolutely free", "free gift", "free trial", "free access", "no obligation",
      "risk-free", "risk free", "cheap", "discount", "special promotion", "exclusive deal", "order now",
      "make money fast", "earn extra cash", "earn money", "work from home", "extra income", "weight loss",
      "lose weight", "casino", "viagra", "cialis", "online pharmacy", "no prescription", "no credit check",
      "guaranteed", "double your", "miracle", "best price", "lowest price", "bulk email", "increase your sales",
      "seo services", "replica", "rolex", "bitcoin investment", "crypto giveaway", "amazing offer",
      "once in a lifetime", "don't miss out", "save up to", "dear friend", "free spins", "claim your reward"
    ],
    "urgency_phrases": [
      "urgent", "immediately", "act now", "right away", "as soon as possible", "asap", "within 24 hours",
      "within 48 hours", "expires today", "expires soon", "final notice", "last chance", "final warning",
      "immediate action required", "action required", "respond immediately", "time sensitive", "don't delay",
      "today only", "before it's too late", "failure to", "avoid suspension", "offer expires"
    ],
    "credential_requests": [
      "verify your account", "verify your identity", "verify your password", "confirm your password",
      "confirm your account", "confirm your identity", "enter your password", "update your password",
      "validate your account", "validate your wallet", "update your payment", "update your billing",
      "update your account information", "login credentials", "log in to verify", "sign in to verify",
      "sign in to confirm", "sign in with your email", "log in with your email", "social security number",
      "credit card number", "card number", "cvv", "security code", "one-time code", "one time password",
      "otp", "pin number", "bank account details", "account credentials", "re-enter your", "revalidate",
      "your password has expired", "password will expire", "password expires", "recovery phrase", "seed phrase"
    ],
    "threats": [
      "account suspended", "account has been suspended", "account will be suspended", "account locked",
      "account has been locked", "account will be closed", "account has been limited", "unusual activity",
      "unauthorized access", "unauthorized login", "suspicious activity", "security alert", "has been compromised",
      "permanently disabled", "will be deactivated", "legal action", "mailbox is full", "storage is full",
      "payment failed", "payment declined", "unable to deliver", "package could not be delivered", "has been locked"
    ],
    "financial_lures": [
      "lottery", "jackpot", "prize", "you have been selected", "inheritance", "million dollars", "million usd",
      "next of kin", "beneficiary", "transfer funds", "wire transfer", "unclaimed funds", "claim your",
      "fund release", "business proposal", "investment opportunity", "guaranteed returns", "double your money",
      "cash reward", "gift card", "gift cards", "western union", "moneygram"
    ]
  },
  "rules": [
    {"id": "PH01", "name": "Look-alike brand domain in sender", "category": "phishing", "weight": 35,
     "condition": {"feature": "lookalike_brand_domain", "op": "true"}, "evidence": "lookalike_brand_domain",
     "description": "The sender domain imitates a known brand (including digit/letter swaps such as paypa1) but is not one of that brand's real domains."},
    {"id": "PH02", "name": "Brand name in display name, wrong sender domain", "category": "phishing", "weight": 30,
     "condition": {"feature": "display_name_brand_mismatch", "op": "true"}, "evidence": "display_name_brand_mismatch",
     "description": "The display name claims to be a known brand but the sending domain does not belong to that brand."},
    {"id": "PH03", "name": "Reply-To domain differs from From domain", "category": "phishing", "weight": 20,
     "condition": {"feature": "reply_to_mismatch", "op": "true"}, "evidence": "reply_to_domain",
     "description": "Replies would be routed to a different domain than the visible sender."},
    {"id": "PH04", "name": "Return-Path domain differs from From domain", "category": "phishing", "weight": 6,
     "condition": {"feature": "return_path_mismatch", "op": "true"},
     "description": "Envelope sender domain differs from the visible sender (weak signal; common with mailing services)."},
    {"id": "PH05", "name": "Message-ID domain differs from From domain", "category": "phishing", "weight": 4,
     "condition": {"feature": "message_id_domain_mismatch", "op": "true"},
     "description": "Message-ID was generated by a different domain than the visible sender (weak signal)."},
    {"id": "PH06", "name": "Credential / sensitive-data request phrases", "category": "phishing", "weight": 36, "per_hit": 12,
     "condition": {"feature": "credential_count", "op": "gte", "value": 1}, "evidence": "credential_phrases",
     "description": "The message asks the recipient to verify, confirm or enter passwords, codes or financial details."},
    {"id": "PH07", "name": "Credential request combined with a link", "category": "phishing", "weight": 15,
     "condition": {"feature": "credential_request_with_link", "op": "true"},
     "description": "A credential request appears alongside at least one URL."},
    {"id": "PH08", "name": "Account-threat phrases", "category": "phishing", "weight": 16, "per_hit": 8,
     "condition": {"feature": "threat_count", "op": "gte", "value": 1}, "evidence": "threat_phrases",
     "description": "Threats such as suspension, locked accounts or failed payments used to pressure the recipient."},
    {"id": "PH09", "name": "Email authentication failures (SPF/DKIM/DMARC)", "category": "phishing", "weight": 30, "per_hit": 12,
     "condition": {"feature": "auth_fail_count", "op": "gte", "value": 1}, "evidence": "auth_summary",
     "description": "One or more authentication mechanisms reported fail, softfail or permerror."},
    {"id": "PH10", "name": "URL uses a raw IP address", "category": "phishing", "weight": 25,
     "condition": {"feature": "url_has_ip_host", "op": "true"}, "evidence": "url_flags.ip_host",
     "description": "Links pointing to bare IP addresses are rarely used by legitimate senders."},
    {"id": "PH11", "name": "Link text does not match link target", "category": "phishing", "weight": 30,
     "condition": {"feature": "anchor_mismatch_count", "op": "gte", "value": 1}, "evidence": "anchor_mismatches",
     "description": "Visible link text shows one domain while the underlying href goes to another."},
    {"id": "PH12", "name": "URL contains '@' (userinfo trick)", "category": "phishing", "weight": 15,
     "condition": {"feature": "url_has_at_symbol", "op": "true"}, "evidence": "url_flags.at_symbol",
     "description": "'@' inside a URL can hide the real destination."},
    {"id": "PH13", "name": "Punycode / IDN host in URL", "category": "phishing", "weight": 15,
     "condition": {"feature": "url_has_punycode", "op": "true"}, "evidence": "url_flags.punycode",
     "description": "Internationalised domains can visually imitate real brands."},
    {"id": "PH14", "name": "Brand name inside URL host, wrong domain", "category": "phishing", "weight": 25,
     "condition": {"feature": "url_brand_mismatch", "op": "true"}, "evidence": "url_brand_mismatch",
     "description": "A URL host mentions a brand but is not one of that brand's domains."},
    {"id": "PH15", "name": "URL with many subdomain levels", "category": "phishing", "weight": 8,
     "condition": {"feature": "url_has_many_subdomains", "op": "true"}, "evidence": "url_flags.many_subdomains",
     "description": "Deeply nested subdomains are often used to bury the real domain."},
    {"id": "PH16", "name": "HTML form with password field", "category": "phishing", "weight": 30,
     "condition": {"feature": "has_password_form", "op": "true"},
     "description": "The email body itself embeds a password form."},
    {"id": "PH17", "name": "Executable / script attachment", "category": "phishing", "weight": 30,
     "condition": {"feature": "has_dangerous_attachment", "op": "true"}, "evidence": "dangerous_attachments",
     "description": "Attachment extension is executable or scriptable (exe, scr, js, vbs, ...). Never opened by this tool."},
    {"id": "PH18", "name": "Double-extension attachment", "category": "phishing", "weight": 30,
     "condition": {"feature": "has_double_extension", "op": "true"}, "evidence": "double_extension_attachments",
     "description": "Names like invoice.pdf.exe disguise an executable as a document."},
    {"id": "PH19", "name": "HTML attachment", "category": "phishing", "weight": 25,
     "condition": {"feature": "has_html_attachment", "op": "true"}, "evidence": "html_attachments",
     "description": "HTML attachments are a common credential-harvesting vector."},
    {"id": "PH20", "name": "Macro-enabled Office attachment", "category": "phishing", "weight": 20,
     "condition": {"feature": "has_macro_attachment", "op": "true"}, "evidence": "macro_attachments",
     "description": "Macro-enabled documents can run code when opened."},
    {"id": "PH21", "name": "Archive attachment", "category": "phishing", "weight": 5,
     "condition": {"feature": "has_archive_attachment", "op": "true"}, "evidence": "archive_attachments",
     "description": "Archives can hide payloads from simple scanners (weak signal)."},
    {"id": "PH22", "name": "URL host with many hyphens", "category": "phishing", "weight": 6,
     "condition": {"feature": "url_has_excess_hyphens", "op": "true"}, "evidence": "url_flags.excess_hyphens",
     "description": "Hosts such as secure-login-update-account.example are typical of throwaway phishing domains."},
    {"id": "PH23", "name": "Executive title with free-mail sender", "category": "phishing", "weight": 25,
     "condition": {"feature": "executive_free_mail", "op": "true"}, "evidence": "from_name",
     "description": "Business-email-compromise pattern: an executive/payroll title in the display name sent from a free-mail account."},

    {"id": "BO01", "name": "Urgency language", "category": "both", "weight": 15, "per_hit": 5,
     "condition": {"feature": "urgency_count", "op": "gte", "value": 1}, "evidence": "urgency_phrases",
     "description": "Pressure tactics such as 'act now' or 'within 24 hours'."},
    {"id": "BO02", "name": "URL shortener", "category": "both", "weight": 10,
     "condition": {"feature": "url_has_shortener", "op": "true"}, "evidence": "url_flags.shortener",
     "description": "Shortened links hide the real destination."},
    {"id": "BO03", "name": "URL on a frequently abused TLD", "category": "both", "weight": 10,
     "condition": {"feature": "url_has_suspicious_tld", "op": "true"}, "evidence": "url_flags.suspicious_tld",
     "description": "Links on TLDs with a high abuse rate (top, xyz, click, ...)."},
    {"id": "BO04", "name": "Sender on a frequently abused TLD", "category": "both", "weight": 8,
     "condition": {"feature": "sender_suspicious_tld", "op": "true"}, "evidence": "from_domain",
     "description": "The sender's domain uses a TLD with a high abuse rate."},
    {"id": "LG01", "name": "SPF/DKIM/DMARC passes (mitigating)", "category": "both", "weight": -15,
     "condition": {"feature": "auth_pass_count", "op": "gte", "value": 2}, "evidence": "auth_summary",
     "description": "At least two authentication mechanisms passed, which lowers the risk of spoofing."},

    {"id": "SP01", "name": "Spam keywords", "category": "spam", "weight": 40, "per_hit": 8,
     "condition": {"feature": "spam_keyword_count", "op": "gte", "value": 1}, "evidence": "spam_keywords",
     "description": "Typical bulk-mail / scam vocabulary (distinct phrases, 8 points each, capped)."},
    {"id": "SP02", "name": "Financial lure phrases", "category": "spam", "weight": 40, "per_hit": 10,
     "condition": {"feature": "financial_lure_count", "op": "gte", "value": 1}, "evidence": "financial_lure_phrases",
     "description": "Lottery, inheritance, prize and advance-fee vocabulary."},
    {"id": "SP03", "name": "Excessive exclamation marks", "category": "spam", "weight": 8,
     "condition": {"feature": "exclamation_count", "op": "gte", "value": 3}, "evidence": "exclamation_count",
     "description": "Three or more exclamation marks."},
    {"id": "SP04", "name": "High proportion of capital letters", "category": "spam", "weight": 10,
     "condition": {"feature": "caps_ratio", "op": "gte", "value": 0.4}, "evidence": "caps_ratio",
     "description": "At least 40% of letters are uppercase."},
    {"id": "SP05", "name": "Subject mostly capitals", "category": "spam", "weight": 8,
     "condition": {"feature": "subject_caps_ratio", "op": "gte", "value": 0.7}, "evidence": "subject_caps_ratio",
     "description": "At least 70% of subject letters are uppercase."},
    {"id": "SP06", "name": "Multiple currency amounts", "category": "spam", "weight": 6,
     "condition": {"feature": "currency_amount_count", "op": "gte", "value": 2}, "evidence": "currency_amount_count",
     "description": "Two or more money amounts in the text."},
    {"id": "SP07", "name": "Unsubscribe text (bulk mail indicator)", "category": "spam", "weight": 6,
     "condition": {"feature": "has_unsubscribe", "op": "true"},
     "description": "Messages offering an unsubscribe option are typically bulk mailings."},
    {"id": "SP08", "name": "Many links", "category": "spam", "weight": 8,
     "condition": {"feature": "url_count", "op": "gte", "value": 5}, "evidence": "url_count",
     "description": "Five or more distinct links."},
    {"id": "SP09", "name": "Empty subject line", "category": "spam", "weight": 5,
     "condition": {"feature": "subject_empty", "op": "true"},
     "description": "Missing subject (weak signal)."},
    {"id": "SP10", "name": "Email authentication failures (bulk-mail context)", "category": "spam", "weight": 12, "per_hit": 6,
     "condition": {"feature": "auth_fail_count", "op": "gte", "value": 1}, "evidence": "auth_summary",
     "description": "Authentication failures also raise the spam score, at a lower weight than for phishing."}
  ]
}
